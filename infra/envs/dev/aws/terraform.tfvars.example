account_id  = "780601577639"
region      = "us-east-1" # the org SCP allows only us-east-1
dr_region   = "us-east-1" # no second region allowed -> no cross-region copy
environment = "dev"
vpc_cidr    = "10.60.0.0/16"

# curl -s https://checkip.amazonaws.com
admin_cidrs = ["203.0.113.10/32"]

github_repo              = "nsbertone/incode-realworld"
# GitHub sends immutable OIDC subjects for this repo (owner and repo IDs)
github_sub_prefix        = "repo:nsbertone@213944955/incode-realworld@1447323414"
github_oidc_provider_arn = "arn:aws:iam::780601577639:oidc-provider/token.actions.githubusercontent.com"
tfstate_bucket           = "realworld-tfstate-780601577639"
alert_email              = "you@example.com"

# Cost/HA knobs for the lab
single_nat_gateway = true
db_multi_az        = true
lab_mode           = true
enable_aws_backup  = false # backup:* denied by the org SCP -> RDS backups + DLM
enable_inspector   = false # enabled and managed by the organization (EC2, ECR, Lambda)

# The org SCP allows only t2/t3/t3a up to .medium (2 vCPU, 4 GiB)
node_instance_types = ["t3.medium", "t3a.medium"]
node_desired_size   = 4

# Optional custom domain (end-to-end TLS):
# domain_name    = "app.example.com"
# hosted_zone_id = "Z0123456789ABCDEF"
